{
  "name": "knowlege-api",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "workspaces": [
    "front-knowledge"
  ],
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "main": "server.js",
  "scripts": {
    "test": "node --test test/coursePermissions.test.js test/validation.test.js test/dependencyLock.test.js",
    "create-admin": "node --no-deprecation scripts/create-admin.js",
    "start": "node --no-deprecation server",
    "server": "nodemon --exec \"node --no-deprecation\" server",
    "client": "npm start --workspace front-knowledge",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --workspace front-knowledge",
    "test:client": "npm test --workspace front-knowledge -- --watchAll=false"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "2.4.3",
    "config": "3.2.5",
    "express": "4.17.1",
    "express-validator": "6.4.0",
    "jsonwebtoken": "8.5.1",
    "mongoose": "5.8.11"
  },
  "devDependencies": {
    "concurrently": "5.1.0",
    "nodemon": "2.0.2"
  }
}
